<Project Sdk="Microsoft.NET.Sdk">

  <!-- The FolidStruct app: template manager and "New project" window, packaged
       as MSIX together with the File Explorer menu (FolidStruct.ContextMenu). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>FolidStruct.App</RootNamespace>
    <AssemblyName>FolidStruct</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FolidStruct.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <!-- MSIX packages carry their own .NET; the Windows App SDK runtime is a
         framework package that the Store installs automatically. -->
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs has its own Main, to keep a single manager window. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Store packages: set by the CI workflow. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\FolidStruct.ico" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The File Explorer menu handler, built before this project
       (see windows/build.ps1). -->
  <PropertyGroup>
    <ContextMenuDll>$(MSBuildThisFileDirectory)..\FolidStruct.ContextMenu\bin\$(Platform)\$(Configuration)\FolidStruct.ContextMenu.dll</ContextMenuDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ContextMenuDll)')">
    <Content Include="$(ContextMenuDll)" Link="FolidStruct.ContextMenu.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckContextMenuDll" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(ContextMenuDll)')"
           Text="Build FolidStruct.ContextMenu for $(Platform) first: $(ContextMenuDll) is missing." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolidStruct.Core\FolidStruct.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
